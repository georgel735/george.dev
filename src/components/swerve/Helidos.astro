---
import { Image } from "astro:assets";
import Helidos from "../../assets/swerve/helidos.webp";
---

<div>
  <Image
    class="project-image border border-black"
    src={Helidos}
    alt="Helidos flic"
    loading="lazy"
    decoding="async"
    densities={[1, 2, 3]}
  />
</div>

<style>
  .project-image {
    width: 100%;
    height: auto;
  }
</style>