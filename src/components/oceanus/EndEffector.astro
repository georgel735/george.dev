---
import { Image } from "astro:assets";
import EndEffector from "../../assets/oceanus/endEffector.png";
---

<div>
  <Image
    class="project-image border border-black"
    src={EndEffector}
    alt="Oceanus End Effector"
    densities={[1, 2, 3]}
  />
</div>

<style>
  .project-image {
    width: 100%;
    height: auto;
  }
</style>