---
import { Image } from "astro:assets";
import OceanusCad from "../../assets/oceanus/oceanusCad.webp";
---

<div>
  <Image
    class="project-image border border-black"
    src={OceanusCad}
    alt="Oceanus CAD Model"
    densities={[1, 2, 3]}
  />
</div>

<style>
  .project-image {
    width: 100%;
    height: auto;
  }
</style>