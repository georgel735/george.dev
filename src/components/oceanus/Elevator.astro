---
import { Image } from "astro:assets";
import Elevator from "../../assets/oceanus/elevator.webp";
---

<div>
  <Image
    class="project-image border border-black"
    src={Elevator}
    alt="Oceanus Elevator"
    densities={[1, 2, 3]}
  />
</div>

<style>
  .project-image {
    width: 100%;
    height: auto;
  }
</style>